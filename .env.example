# ===================================================================
# PILIHAN 1: SUPABASE (PostgreSQL Cloud) - Rekomendasi untuk Power BI
# ===================================================================
DB_TYPE=postgres
DB_HOST=
# Catatan: Jika jaringan internet Anda IPv4-only, gunakan host Connection Pooler:
# DB_HOST=
# DB_USER=
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=require

# ===================================================================
# PILIHAN 2: MYSQL 8.0 LOCALHOST
# ===================================================================
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=online_retail_dw

# Path File Sumber & Direktori Staging
DATA_FILE_PATH=data/Online_Retail_Hasil_Cleaning.csv
STAGING_DIR=staging

# Parameter Eksekusi
BATCH_SIZE=20000
RESET_TABLES=true
